{
  "name": "fendaria",
  "version": "1.1.0",
  "private": true,
  "description": "Fendaria: hack & slash para Android (Capacitor)",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "sync": "npx cap sync android",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "eas-build-post-install": "npx cap sync android",
    "eas:apk": "npx eas-cli build -p android --profile preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
